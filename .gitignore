# S01-01A .gitignore
# 🔴 Deliberately NOT ignored (they are project deliverables / authoritative records):
#    docs/  20_INTEGRATION/  30_SPIKES/  src/  package.json  package-lock.json  .learnbuddy/  tsconfig*.json

# --- Dependencies ---
node_modules/

# --- Build output (regenerated by `npm run build` / `npm test` / `npm run test:proxy`) ---
dist/
dist-test/
dist-proxy-test/
coverage/

# --- Web build output (S01-06, regenerated by `npm run build:web`) ---
# Deliberately a SEPARATE directory so the core build and the web build can never overwrite
# each other's emitted files.
dist-web/

# --- Environment files (never commit real values) ---
.env
.env.*
!.env.example

# --- Credentials / secrets (never commit real values) ---
# 🚩 GIT-RECOVERY-01 §9 审计新增：此前无任何 credential 规则，新仓库首次 add 前补齐。
*.pem
*.key
*.pfx
*.p12
*.jks
*.keystore
id_rsa
id_ed25519
credentials.json
secrets.json
.npmrc

# --- Temporary browser profiles (CDP / smoke runs: always a throwaway --user-data-dir) ---
# 🚩 GIT-RECOVERY-01 §9 审计新增。
.chrome-profile/
.chromium-profile/
.browser-profile/
.cdp-profile/
chrome-profile/
chromium-profile/
browser-profile/
user-data-dir/

# --- Temporary smoke evidence (throwaway runs only) ---
# 🚩 GIT-RECOVERY-01 §9 审计新增。
# 🔴 不得在此加全局 results/ 或 screenshots/ —— 30_SPIKES/** 下的 results/ · screenshots/
#    是 SP-06 等 Spike 的**审计产物**（被 SP-06_EXECUTION_REPORT.md 引用），必须提交；
#    临时 smoke 证据应写到仓库外的临时目录，或明确落在下面这些路径内。
/smoke-evidence/
/tmp-smoke/
/smoke-results/

# --- Logs & OS noise ---
*.log
.DS_Store
Thumbs.db
# 🚩 GIT-RECOVERY-01 §9 审计新增：Windows / 编辑器垃圾文件。
Desktop.ini
desktop.ini
ehthumbs.db
$RECYCLE.BIN/
*.tmp
*.bak
*.swp
*~
~$*
